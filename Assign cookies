class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        sort(g.begin(),g.end());
        sort(s.begin(),s.end());
        int high=0;
        int low=0;
        int cnt=0;
        while(high<g.size() && low<s.size()){
            if(s[low]>=g[high]){
                cnt++;   
                high++;
            }
            low++;  
        }
        return cnt;
    }
};
