class Solution {
public:
    vector<int>ans;
    void firstocc(vector<int>& nums,int target){
        int low=0;
        int high=nums.size()-1;
        int first=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==target){
                first=mid;
                high=mid-1;
            }
            else if(nums[mid]>target){
                high=mid-1;
            }
            else {
                low=mid+1;
            }            
        }
        ans.push_back(first);
    }
    void secondocc(vector<int>&nums ,int target){
        int low=0;
        int high=nums.size()-1;
        int second=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==target){
                second=mid;
                low=mid+1;
            }
            else if(nums[mid]<target){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        ans.push_back(second);
    }
    vector<int> searchRange(vector<int>& nums, int target) {
        firstocc(nums,target);
        secondocc(nums,target);
        return ans;  
    }
};
