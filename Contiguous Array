class Solution {
public:
    int findMaxLength(vector<int>& nums) {
        unordered_map<int,int>mp;
        int len=0;
        mp[0]=-1;
        int sum=0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]==1){
                sum++;
            }
            if(nums[i]==0){
                sum--;
            }
            if(mp.find(sum)!=mp.end()){
                len=max(len,i-mp[sum]);
            }
            else{
                mp[sum]=i;
            }
        }
        return len;
    }
};
