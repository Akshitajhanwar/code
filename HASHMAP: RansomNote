class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        unordered_map<char,int>mp;
        for(auto it:magazine){
            mp[it]++;
        }
        for(int i=0;i<ransomNote.size();i++){
            if(mp.find(ransomNote[i])==mp.end()){
                return false;
            }
            mp[ransomNote[i]]--;
            if(mp[ransomNote[i]]<0){
                return false;
            }
        }   
    return true;    
    }
};
