class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int sum=0;
        int high=0;
        int low=0;
        int maxi=INT_MIN;
        while(high<nums.size()){
            sum=sum+nums[high];
            maxi=max(maxi,sum);
            if(sum<0){
                sum=0;
            }
            high++;
        }
        return maxi;
    }
};
