

class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double sum=0;
        double maxi=INT_MIN;
        int high=0;
        int low=0;
        while(high<nums.size()){
            sum=sum+nums[high];
            if((high-low+1)==k){
                double avg = sum/k;
                maxi=max(maxi,avg);
                sum=sum-nums[low];
                low++;
            }
            high++;
        }
        return maxi;   
    }
};
