class Solution {
public:
    int minimumCost(vector<int>& cost) {
        int mini=INT_MAX;
        int sum=0;
        sort(cost.begin(),cost.end(),greater<int>());
        for(int high=0;high<cost.size();high++){
            if((high+1)%3!=0){
                sum=sum+cost[high];
            } 
        }
        return sum;        
    }
};
