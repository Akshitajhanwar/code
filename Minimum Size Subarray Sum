Minimum Size Subarray Sum

class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int low=0;
        int high=0;
        int mini=INT_MAX;
        int sum=0;
        while(high<nums.size()){
            sum=sum+nums[high];      
            while(sum>=target){
                mini=min(mini,high-low+1);
                sum=sum-nums[low];
                low++;
            }
            high++;
        }
        return (mini==INT_MAX?0:mini);
    }
};
