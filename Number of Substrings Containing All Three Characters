class Solution {
public:
    int numberOfSubstrings(string s) {
        int cnt=0;
        int low=0;
        int high=0;
        unordered_map<char,int>mp;
        while(high<s.size()){
            mp[s[high]]++;
            while(mp['a']>0 && mp['b']>0 && mp['c']>0){
                cnt+=s.size()-high;
                mp[s[low]]--;
                low++;
            }
            high++;
        }
        return cnt;
    }
};
