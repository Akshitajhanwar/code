class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& temperatures) {
        stack<int>st;
        vector<int>ans(temperatures.size());
        int cnt=0;
        for(int i=temperatures.size()-1;i>=0;i--){
            while(!st.empty() && temperatures[st.top()]<=temperatures[i]){
                st.pop();
            }
            if(!st.empty()){
                int index=st.top();
                ans[i]=index-i;
            }
            else{
                ans[i]=0;
            }
            st.push(i);
        }
        return ans;
    }
};
