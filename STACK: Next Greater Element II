class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        vector<int>ans(nums.size());
        stack<int>st;
        for(int i=2*nums.size()-1;i>=0;i--){
            int index=i%nums.size();
            while(!st.empty() && st.top()<=nums[index]){
                st.pop();
            }
            if(i<nums.size()){
                if(st.empty()){
                    ans[index]=-1;
                }
                else{
                    ans[index]=st.top();
                }
            }
            st.push(nums[index]);
        }
        return ans;
    }
};
