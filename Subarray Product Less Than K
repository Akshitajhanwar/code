Subarray Product Less Than K

class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        int low=0;
        int high=0;
        int cnt=0;
        long long prod=1;
        if(k<=1){
            return 0;
        }
        while(high<nums.size()){
            prod=prod*nums[high];
            while(prod>=k){
                prod=prod/nums[low];
                low++;
            }
            cnt=cnt+(high-low+1);
            high++;
        }
        return cnt;
       
    }
};

