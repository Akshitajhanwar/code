class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        unordered_map<int,int>mp;
        for(auto it:nums){
            mp[it];
        }
        mp[0]=1;
        int presum=0;
        int cnt=0;
        int sum=0;
        for(int i=0;i<nums.size();i++){
            presum=presum+nums[i];
            sum=presum-k;
            if(mp.find(sum)!=mp.end()){
                cnt=cnt+mp[sum];
            }
            mp[presum]++;
        }
        return cnt;
    }
};
