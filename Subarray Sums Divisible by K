class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        unordered_map<int,int>mp;
        for(auto it:nums){
            mp[it];
        }
        mp[0]=1;
        int presum=0;
        int cnt=0;
        for(int i=0;i<nums.size();i++){
            presum=presum+nums[i];
            int res=presum%k;
            if( res<0){ 
                res=res+k;
            }
            cnt=cnt+mp[res];
            mp[res]++;
        }
        return cnt;  
    }
};
