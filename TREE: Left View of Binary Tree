class Solution {
  public:
    vector<int> leftView(Node *root) {
        // code here
        if(root==NULL){
            return {};
        }
        vector<int>ans;
        queue<Node*>q;
        q.push(root);
        while(!q.empty()){
            int n=q.size();
            Node* curr=q.front();
            ans.push_back(curr->data);
            while(n--){
                curr=q.front();
                q.pop();
                if(curr->left!=NULL){
                    q.push(curr->left);
                }
                if(curr->right){
                    q.push(curr->right);
                }
            }
        }
        return ans;
        
    }
};
