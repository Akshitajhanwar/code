class Solution {
public:
    int thirdMax(vector<int>& nums) {
        int cnt=1;
        int n = nums.size();
        sort(nums.begin(),nums.end(),greater<int>());
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i]!=nums[i+1]){
                cnt++;
            }
            if(cnt==3){
                return nums[i+1];
            } 
        }
        return nums[0];
    }
};
