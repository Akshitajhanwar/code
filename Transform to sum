Given a Binary Tree of size N , where each node can have positive or negative values. 
Convert this to a tree where each node contains the sum of the left and right sub trees of the original tree.
The values of leaf nodes are changed to 0.


/* A binary tree node
struct Node
{
    int data;
    Node* left, * right;
}; */

class Solution {
  public:

    // Convert a given tree to a tree where every node contains sum of values of
    // nodes in left and right subtrees in the original tree
    int toSumTree(Node *node) {
        // Your code here
        if(node==NULL){
            return 0;
        }
        int left = toSumTree(node->left);
        int right = toSumTree(node->right);
        int old = node->data;
        node->data = left+right;
        return old+left+right;
    }
};
