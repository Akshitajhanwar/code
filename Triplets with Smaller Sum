Triplets with Smaller Sum


class Solution {

  public:
    long long countTriplets(int n, long long sum, long long arr[]) {
        // Your code goes here
        
        long long cnt=0;
        sort(arr,arr+n);
        for(int i=0;i<n-2;i++){
            int k=n-1;
            int j=i+1;
            if(i>0 && arr[i]==arr[i-1]){
                continue;
            }
            while(j<k){
                long long tot = arr[i]+arr[j]+arr[k];
                if(sum>tot){
                    cnt=cnt+(k-j);
                    j++;
                    }
                else{
                    k--;
                    }
                }
            }
        return cnt;
    }
};
