

class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int>ans;
        unordered_map<char,int>pfreq;
        unordered_map<char,int>window;
        int low=0;
        int high=0;
        for(auto it:p){
            pfreq[it]++;
        }
        while(high<s.size()){
            window[s[high]]++;
            if((high-low+1)>p.size()){
                window[s[low]]--;
                if(window[s[low]]==0){
                    window.erase(s[low]);
                }
                low++;
            } 
            if((high-low+1)==p.size()){
                if(window==pfreq){
                    ans.push_back(low);
                }
            }  
            high++;
            }
        return ans;
    }
};
