Given an array of integers, return a new array where all duplicate elements are removed while maintaining the original order of elements.


class Solution {
public:
    vector <int>makeUniqueArray(vector<int>& nums) {
        vector<int>ans;
        unordered_set<int>seen;
        for(int i=0;i<nums.size();i++){
            if(seen.find(nums[i])==seen.end()){
                ans.push_back(nums[i]);
                seen.insert(nums[i]);
            }
        }
    return ans;
    }
};
