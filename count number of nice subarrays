class Solution {
public:
    int solve(vector<int>& nums, int k) {
        int high=0;
        int low=0;
        int cnt=0;
        int temp=0;
        while(high<nums.size()){
            if(nums[high]%2!=0){
                cnt++;
            }
            while(cnt>k){
                if(nums[low]%2!=0){
                    cnt--;
                }
                low++;
            }
            temp=temp+(high-low+1);
            high++;
        }
        return temp;
    }
    int numberOfSubarrays(vector<int>&sub,int k){
        return solve(sub,k)-solve(sub,k-1);
    }
};
