
Given an array of integers and an integer k, rotate the array to the right by k steps.


class Solution {
public:
    vector<int> rotateAnArrayByK(vector<int>& nums,int k) {
        int n = nums.size();
        k = k%n;
        
        vector<int>ans(n);  
        for(int i=0;i<n;i++){
                ans[(i+k)%n] = nums[i];
            }
            
        return ans;
    }
};


